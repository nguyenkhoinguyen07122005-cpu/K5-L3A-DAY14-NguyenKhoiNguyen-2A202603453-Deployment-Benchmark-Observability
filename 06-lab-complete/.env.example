# Copy thành .env rồi điền giá trị thật:  cp .env.example .env
# File .env đã nằm trong .gitignore và .dockerignore — KHÔNG commit secret.

# ── Server ──
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Security ──
# Tạo key ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=replace-with-a-random-secret

# ── State (Redis) ──
# Local: redis://localhost:6379/0 · Docker Compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Rate limit & cost guard ──
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0

# ── Conversation history ──
HISTORY_MAX_MESSAGES=20
